<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nebula_jari_tools</name>
  <version>0.1.0</version>
  <description>Offline JARI PCAP to MCAP conversion utilities for Nebula LiDAR drivers.</description>
  <maintainer email="max.schmeller@tier4.jp">Max Schmeller</maintainer>
  <license>Apache 2</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>libtins-dev</depend>
  <depend>nebula_core_common</depend>
  <depend>nebula_core_decoders</depend>
  <depend>nebula_core_ros</depend>
  <depend>nebula_hesai_common</depend>
  <depend>nebula_hesai_decoders</depend>
  <depend>nebula_msgs</depend>
  <depend>nebula_robosense_common</depend>
  <depend>nebula_robosense_decoders</depend>
  <depend>nebula_seyond_common</depend>
  <depend>nebula_seyond_decoders</depend>
  <depend>pandar_msgs</depend>
  <depend>rclcpp</depend>
  <depend>robosense_msgs</depend>
  <depend>rosbag2_cpp</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
